{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$p = ($env:CLAUDE_PLUGIN_ROOT -replace '^/([A-Za-z])/', '$1:/'); & ($p + '/hooks/pre-commit-review.ps1'); exit $LASTEXITCODE\"",
            "timeout": 15,
            "statusMessage": "zy-skills review gate: checking commit approval"
          }
        ]
      }
    ]
  }
}
